# Variáveis do scaffold. Copie para `.env` e ajuste. Os valores abaixo são os da stack do
# `docker-compose.yml`. Só o módulo `bootstrap/settings.py` (e `job_settings.py`) lê o ambiente.

# ---------------------------------------------------------------------------------------------
# Comuns a todo processo (API, CLI, Streamlit e job da outbox)
# ---------------------------------------------------------------------------------------------

# Obrigatória. O nome do serviço em todo sinal: o `job` no Prometheus, o serviço no Jaeger e o
# campo `service` de cada linha de log.
OTEL_SERVICE_NAME=scafold

# Obrigatória. Postgres, esquema `postgresql://`, sem driver: quem acrescenta o `+asyncpg` é a
# camada de dados.
DATABASE_URL=postgresql://app:app@localhost:5432/app?sslmode=disable

# Por padrão o log só mostra WARNING e ERROR. Com `true`, mostra tudo (DEBUG): início e fim de
# use case, medições escritas no log, saída dos handlers de evento. Só `true` e `false`.
LOG_DEBUG=false

# Cada sinal tem a sua variável, e os dois nascem LIGADOS. Só `true` e `false` são aceitos.
# Desligadas, as medições de use case e de banco vão para o log, em DEBUG.
TELEMETRY_METRICS_ENABLED=false
TELEMETRY_TRACES_ENABLED=false

# Para onde cada sinal vai, por OTLP sobre HTTP. Aqui cada um tem o seu destino.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:9090/api/v1/otlp/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# O carimbo das mensagens novas da outbox. Obrigatória nos processos que gravam eventos de
# integração (API, CLI, Streamlit) e no job. Valores aceitos: rabbitmq.
OUTBOX_DISPATCHER=rabbitmq

# ---------------------------------------------------------------------------------------------
# Só a API
# ---------------------------------------------------------------------------------------------

# Liga a tela do Swagger (`/docs`) e o `/openapi.json`. Ausente, ficam desligados. As rotas são
# sempre documentadas no código; esta variável só decide se o documento é servido.
API_EXPOSE_DOCS=true

# ---------------------------------------------------------------------------------------------
# Só o job da outbox
# ---------------------------------------------------------------------------------------------

RABBITMQ_URL=amqp://app:app@localhost:5672/
# Cron de cinco campos, em UTC. Padrão: a cada minuto.
OUTBOX_CRON_SCHEDULE=* * * * *
OUTBOX_BATCH_SIZE=1000
OUTBOX_RETRY_COUNTDOWN=30
